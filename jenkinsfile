pipeline {
    agent any

    stages {
        stage('Get Code') {
            steps {
                checkout scm
            }
        }

        stage('Build Images') {
            steps {
                sh '''
                    docker build -f dockerfile-website1 -t arjunsanthosh803/website1:latest .
                    docker build -f dockerfile-website2 -t arjunsanthosh803/website2:latest .
                '''
            }
        }


stage('Login') {
    steps {
        withCredentials([usernamePassword(
            credentialsId: 'docker-hub-credential',
            usernameVariable: 'DH_USER',
            passwordVariable: 'DH_PASS'
        )]) {
            sh '''
                echo "$DH_PASS" | docker login \
                    -u "$DH_USER" --password-stdin
            '''
        }
    }
}

        stage('Push Images') {
            steps {
                sh '''
                    docker push arjunsanthosh803/website1:latest
                    docker push arjunsanthosh803/website2:latest
                '''
            }
        }

        stage('Deploy') {
            steps {
                dir('Docker_Jenkins_Automated_Web_Deployment') {
                    sh '''
                        docker compose pull
                        docker compose -f docker-compose.yml up -d
                        docker ps
                    '''
                }
            }
        }
    }
}
